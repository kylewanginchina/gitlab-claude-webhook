# 复制为 .env 后替换所有示例凭据。实际运行时配置会持久化到 DATA_DIR/runtime-config.json。

# Claude（基础 docker-compose.yml 会注入默认超时设置）
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=sk-your-anthropic-token
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-20250514
CLAUDE_REASONING_EFFORT=high
CLAUDE_DEFAULT_TIMEOUT_MINUTES=30

# Codex（基础 docker-compose.yml 会注入默认超时设置）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-proj-your-openai-key
CODEX_DEFAULT_MODEL=gpt-5.1-codex-max
CODEX_REASONING_EFFORT=high
CODEX_DEFAULT_TIMEOUT_MINUTES=30

# 执行器选择：Webhook 指令仍须显式使用 @claude 或 @codex。
AI_DEFAULT_PROVIDER=claude

# GitLab 与 Webhook
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=glpat-your-gitlab-token
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_TASK_CONCURRENCY=2
PORT=3000

# 管理认证与运行目录
ADMIN_TOKEN=change-me-admin-token
DATA_DIR=/app/data
LOG_DIR=/app/logs

# 多轮 Review（基础 docker-compose.yml 会注入全部 REVIEW_* 设置）
REVIEW_ENABLED=true
REVIEW_DEFAULT_PROVIDER=claude-multipass
REVIEW_MIN_CONFIDENCE=80
REVIEW_MAX_CANDIDATE_FINDINGS=12
REVIEW_MAX_FINAL_FINDINGS=8
REVIEW_PASS_CONCURRENCY=4
REVIEW_SCORING_CONCURRENCY=4
REVIEW_SKIP_DRAFT=true
REVIEW_SKIP_EXISTING_SHA=true
REVIEW_ALLOWED_COMMANDS=/code-review
# 内置 SKILL.md 审查技能（review-skills/），按 pass 与变更语言自动启用
REVIEW_USE_BUILTIN_SKILLS=true
# 覆盖技能目录位置（默认为仓库内 review-skills/）
# REVIEW_SKILLS_DIR=/app/review-skills
# Claude 审查阶段使用 JSON Schema 结构化输出，而非解析 Markdown 中的 JSON 代码块
REVIEW_STRUCTURED_OUTPUT=true
# 单个 review pass / 评分阶段允许的最大 agent 轮次（仅 Claude）；0 表示不限制，仅由超时兜底
REVIEW_PASS_MAX_TURNS=0
REVIEW_SCORING_MAX_TURNS=0

# 工作目录与日志
WORK_DIR=/tmp/gitlab-claude-work
LOG_LEVEL=info
